# URLs base de cada grupo de endpoints del backend (monolito Spring Boot,
# puerto 5001 en local). Sin estas variables las llamadas HTTP fallan en
# silencio contra "undefined/..." (ver httpClient.js).
# Para el deploy detras de Caddy ver deploy/README.md (mismas rutas, host HTTPS).
VITE_API_AUTH=http://localhost:5001/api/users/auth
VITE_API_USER=http://localhost:5001/api/users
VITE_API_HOUSE=http://localhost:5001/api/house
VITE_API_RECEIPT=http://localhost:5001/api/receipt
VITE_API_CITY=http://localhost:5001/api/cities
VITE_API_STATISTIC=http://localhost:5001/api/statistic
VITE_API_EMAIL=http://localhost:5001/api/email

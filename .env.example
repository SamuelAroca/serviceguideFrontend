# URLs base de cada microservicio del backend. Sin estas variables las
# llamadas HTTP fallan en silencio contra "undefined/..." (ver httpClient.js).
VITE_API_AUTH=http://localhost:3000/auth
VITE_API_USER=http://localhost:3000/user
VITE_API_HOUSE=http://localhost:3000/house
VITE_API_RECEIPT=http://localhost:3000/receipt
VITE_API_CITY=http://localhost:3000/city
VITE_API_STATISTIC=http://localhost:3000/statistic
VITE_API_EMAIL=http://localhost:3000/email
